{
  "name": "schoolwatch-backend",
  "version": "1.0.0",
  "description": "SchoolWatch Backend API - Bay Area Private School Admissions Tracker",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "db:init": "ts-node src/models/init.ts init",
    "db:drop": "ts-node src/models/init.ts drop",
    "db:reset": "ts-node src/models/init.ts reset",
    "db:seed": "ts-node src/models/seed.ts seed",
    "db:seed:clear": "ts-node src/models/seed.ts clear",
    "db:seed:reset": "ts-node src/models/seed.ts reseed",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "schoolwatch",
    "private-school",
    "admissions"
  ],
  "author": "SchoolWatch Team",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "pg": "^8.16.3",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.3",
    "@types/supertest": "^6.0.3",
    "jest": "^30.2.0",
    "nodemon": "^3.1.11",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
